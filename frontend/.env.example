# Copy this file to .env before a local or production build.

# Canonical origin used by runtime SEO metadata.
VITE_PUBLIC_SITE_URL=https://nexus.example

# Canonical origin used to generate robots.txt and sitemap.xml.
NEXUS_PUBLIC_URL=https://nexus.example

# Release identifier included in feedback context.
VITE_APP_VERSION=0.1.0
