NODE_ENV=development
HOST=0.0.0.0
PORT=4100
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
FEEDBACK_STORE_PATH=./data/feedback.jsonl
SETUP_EVENT_HISTORY_PERSISTENCE_ENABLED=true
SETUP_EVENT_HISTORY_PERSISTENCE_PATH=./data/setup-event-history-v1.json
ALERTS_PERSISTENCE_ENABLED=true
ALERTS_PERSISTENCE_PATH=./data/alerts-runtime-v1.json
UNIFIED_DECISION_LIVE_OBSERVATION_ENABLED=true
UNIFIED_DECISION_LIVE_OBSERVATION_PATH=./data/unified-decision-live-observations-v1.json
UNIFIED_DECISION_LIVE_OBSERVATION_CAPACITY=5000
UNIFIED_DECISION_COVERAGE_GAP_OBSERVATION_ENABLED=true
UNIFIED_DECISION_COVERAGE_GAP_OBSERVATION_PATH=./data/unified-decision-coverage-gaps-v1.json
UNIFIED_DECISION_COVERAGE_GAP_OBSERVATION_CAPACITY=1000
LEVEL_ENGINE_FROZEN_SAMPLE_PATH=./.tmp/level-engine-validation/latest-frozen-sample.json

# Dedicated cyclic storage for market history and liquidation heatmap partitions.
# User feedback and service state are outside this directory and are never removed by this quota.
MARKET_DATA_STORAGE_QUOTA_ENABLED=true
MARKET_DATA_STORAGE_ROOT_PATH=./data/market
MARKET_DATA_STORAGE_MAX_GIB=20
MARKET_DATA_STORAGE_CLEANUP_THRESHOLD_GIB=16
MARKET_DATA_STORAGE_CLEANUP_TARGET_GIB=14
MARKET_DATA_STORAGE_SWEEP_INTERVAL_MS=60000

BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_REQUEST_TIMEOUT_MS=5000
BINANCE_SYMBOLS_LIMIT=1000
BINANCE_CACHE_TTL_MS=15000

BINANCE_WS_ENABLED=true
BINANCE_WS_BASE_URL=wss://fstream.binance.com
BINANCE_WS_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BINANCE_WS_RECONNECT_BASE_DELAY_MS=1000
BINANCE_WS_RECONNECT_MAX_DELAY_MS=30000
BINANCE_WS_TRADES_BUFFER_SIZE=100

BINANCE_ORDER_BOOK_ENABLED=true
BINANCE_ORDER_BOOK_STALE_AFTER_MS=5000

BINANCE_SYMBOL_UNIVERSE_ENABLED=true
BINANCE_SYMBOL_UNIVERSE_REQUEST_TIMEOUT_MS=20000
BINANCE_SYMBOL_UNIVERSE_QUOTE_ASSET=USDT
BINANCE_SYMBOL_UNIVERSE_REFRESH_INTERVAL_MS=60000
BINANCE_SYMBOL_UNIVERSE_COLLECTING_DURATION_MS=900000

BINANCE_MARKET_WIDE_ENABLED=true
BINANCE_MARKET_WIDE_WS_BASE_URL=wss://fstream.binance.com
BINANCE_MARKET_WIDE_MAX_STREAMS_PER_SOCKET=100
BINANCE_MARKET_WIDE_RECONNECT_BASE_DELAY_MS=1000
BINANCE_MARKET_WIDE_RECONNECT_MAX_DELAY_MS=30000

BINANCE_MARKET_WIDE_OPEN_INTEREST_ENABLED=true
BINANCE_MARKET_WIDE_OPEN_INTEREST_INTERVAL_MS=60000
BINANCE_MARKET_WIDE_OPEN_INTEREST_MAX_CONCURRENCY=4

BINANCE_MARKET_WIDE_HISTORY_WARMUP_ENABLED=true
BINANCE_MARKET_WIDE_HISTORY_WARMUP_MINUTES_PER_SYMBOL=4320
BINANCE_MARKET_WIDE_HISTORY_WARMUP_REQUEST_TIMEOUT_MS=15000
BINANCE_MARKET_WIDE_HISTORY_WARMUP_REQUEST_DELAY_MS=250
BINANCE_MARKET_WIDE_HISTORY_WARMUP_MAX_REQUEST_ATTEMPTS=3
BINANCE_MARKET_WIDE_HISTORY_WARMUP_RETRY_BASE_DELAY_MS=1000
